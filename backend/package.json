{
  "name": "@docusense-ai/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.integration.test.ts",
    "prisma:format": "prisma format --config prisma7.config.ts",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma7.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "prisma:migrate:status": "prisma migrate status --config prisma7.config.ts",
    "prisma:studio": "prisma studio --config prisma7.config.ts",
    "db:verify": "tsx src/database/verify-database.ts",
    "indexing:verify": "tsx src/database/verify-indexing.ts",
    "search:verify": "tsx src/database/verify-search.ts",
    "rag:verify": "tsx src/database/verify-rag.ts",
    "rag:evaluate": "tsx src/evaluation/rag-evaluation.ts"
  },
  "dependencies": {
    "@google/genai": "3.3.0",
    "@langchain/core": "1.4.1",
    "@langchain/textsplitters": "1.0.2",
    "@napi-rs/canvas": "1.1.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "8.3.0",
    "mammoth": "1.13.0",
    "multer": "2.5.0",
    "pg": "8.23.1",
    "tesseract.js": "7.0.0",
    "unpdf": "2.2.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
